<style>
*{box-sizing:border-box}body{margin:0;background:#f4f7fb;color:#0f172a;font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;line-height:1.7}
a{color:#0369a1}.container{width:min(860px,calc(100% - 40px));margin:0 auto}
header{background:#020817;color:white;border-bottom:1px solid rgba(255,255,255,.1)}header .container{display:flex;align-items:center;gap:14px;min-height:80px}header img{width:52px;height:52px;border-radius:16px;background:white;padding:4px}header a{color:white;text-decoration:none;font-weight:950;letter-spacing:.04em;font-size:21px}
main{padding:56px 0 72px}h1{font-size:clamp(34px,5vw,48px);line-height:1.1;letter-spacing:-.04em;margin:0 0 8px}.updated{color:#64748b;margin:0 0 32px}
section{background:white;border:1px solid #dbe5f0;border-radius:24px;padding:26px 28px;margin-bottom:18px}h2{font-size:22px;margin:0 0 10px;letter-spacing:-.02em}p,li{color:#334155}ul{padding-left:20px}
