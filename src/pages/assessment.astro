---
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-sans/700.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource/ibm-plex-mono/600.css';
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ACMA v1.1 | Evaluación de madurez en ciberseguridad | ALLUNIFIED</title>
  <link rel="canonical" href="https://www.allunifiedst.com/assessment" />
  <meta name="description" content="ACMA v1.1: Assessment de madurez en ciberseguridad de ALLUNIFIED basado en NIST CSF 2.0 con dashboard, fortalezas, debilidades, roadmap y PDF ejecutivo." />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <style is:global>
    :root{--navy:#020817;--navy2:#071827;--cyan:#22d3ee;--blue:#0b5fff;--ink:#0f172a;--muted:#64748b;--soft:#f4f7fb;--line:#dbe5f0;--green:#16a34a;--yellow:#eab308;--orange:#f97316;--red:#ef4444}
    *{box-sizing:border-box} html{scroll-behavior:smooth} body{margin:0;background:var(--navy);color:white;font-family:"IBM Plex Sans",ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif} a{color:inherit;text-decoration:none} button,input,select{font:inherit}.container{width:min(1180px,calc(100% - 40px));margin:0 auto}
    .header{position:sticky;top:0;z-index:50;background:rgba(2,8,23,.88);border-bottom:1px solid rgba(255,255,255,.1);backdrop-filter:blur(18px)}.nav{min-height:86px;display:flex;justify-content:space-between;align-items:center;gap:18px}.brand{display:flex;align-items:center;gap:14px}.brand img{width:60px;height:60px;border-radius:18px;background:white;padding:4px;object-fit:cover}.brand-title{font-weight:700;font-size:24px;letter-spacing:.04em;line-height:1}.brand-sub{margin-top:6px;font-size:12px;text-transform:uppercase;letter-spacing:.24em;color:rgba(255,255,255,.7)}
    .btn{border:1px solid rgba(255,255,255,.25);border-radius:999px;padding:13px 22px;font-weight:600;background:transparent;color:inherit;cursor:pointer;display:inline-flex;align-items:center;justify-content:center;transition:.2s}.btn:hover{transform:translateY(-1px)}.btn-primary{background:var(--cyan);color:#04121f;border-color:var(--cyan);box-shadow:0 18px 50px rgba(34,211,238,.18)}.btn-dark{background:#020817;border-color:#020817;color:white}.btn-soft{border-color:#cbd5e1;color:#0f172a;background:white}.btn-blue{background:var(--blue);border-color:var(--blue);color:white}
    .hero{padding:86px 0 70px;background:radial-gradient(circle at 18% 10%,rgba(34,211,238,.18),transparent 32%),radial-gradient(circle at 90% 0%,rgba(11,95,255,.30),transparent 36%),linear-gradient(135deg,#020817,#071827 55%,#0a1e58)}.hero-grid{display:grid;grid-template-columns:1.08fr .92fr;gap:62px;align-items:center}.eyebrow{color:var(--cyan);font-weight:500;font-family:"IBM Plex Mono",ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.14em;text-transform:uppercase;font-size:13px;line-height:1.7;margin-bottom:18px}h1{font-size:clamp(44px,6vw,76px);line-height:1.04;letter-spacing:-.03em;margin:0;font-weight:600}.hero-copy{font-size:20px;line-height:1.7;color:rgba(255,255,255,.74);max-width:720px;margin-top:28px}.hero-actions{display:flex;gap:14px;flex-wrap:wrap;margin-top:34px}.hero-card{border:1px solid rgba(255,255,255,.12);background:rgba(255,255,255,.065);border-radius:34px;padding:32px;box-shadow:0 32px 90px rgba(0,0,0,.28)}.hero-card h2{font-size:32px;letter-spacing:-.04em;margin:0 0 12px}.quick-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px;margin-top:24px}.quick{border:1px solid rgba(255,255,255,.1);border-radius:22px;background:rgba(2,8,23,.45);padding:18px}.quick strong{display:block;color:var(--cyan);font-size:31px;font-weight:600}.quick span{color:rgba(255,255,255,.65)}
    .section{padding:80px 0}.white{background:white;color:var(--ink)}.soft{background:var(--soft);color:var(--ink)}.dark{background:var(--navy);color:white}.section-title{font-size:clamp(36px,5vw,58px);line-height:1.05;letter-spacing:-.025em;margin:0;font-weight:600;max-width:930px}.section-copy{color:#64748b;font-size:19px;line-height:1.72;max-width:900px;margin:22px 0 0}.value-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:18px;margin-top:46px}.value-card{background:white;border:1px solid var(--line);border-radius:28px;padding:26px;box-shadow:0 12px 32px rgba(15,23,42,.06)}.value-card strong{font-size:21px;display:block}.value-card p{color:#64748b;line-height:1.62}
    .domain-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:46px}.domain-card{background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.12);border-radius:28px;padding:26px}.domain-icon{width:52px;height:52px;border-radius:18px;background:rgba(34,211,238,.16);display:grid;place-items:center;color:#d6fbff;font-weight:600;font-family:"IBM Plex Mono",ui-monospace,SFMono-Regular,Menlo,monospace;margin-bottom:16px}.domain-card h3{font-size:26px;margin:0}.domain-card p{line-height:1.62;color:rgba(255,255,255,.68)}
    .panel{background:white;border:1px solid var(--line);border-radius:32px;box-shadow:0 20px 60px rgba(15,23,42,.08);overflow:hidden}.wizard-head{padding:30px;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;gap:18px}.wizard-title{font-size:34px;font-weight:600;letter-spacing:-.02em}.wizard-sub{color:#64748b;margin-top:6px;line-height:1.5}.panel-body{padding:30px}.progress{height:12px;background:#e2e8f0;border-radius:999px;overflow:hidden;margin-bottom:28px}.progress-fill{height:100%;width:0;background:linear-gradient(90deg,var(--blue),var(--cyan));border-radius:999px;transition:.25s}.form-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:18px}.field label{display:block;font-weight:850;margin-bottom:8px;color:#334155}.field input,.field select,.question select{width:100%;border:1px solid #cbd5e1;border-radius:16px;padding:14px 15px;background:#fff;color:#0f172a;font-size:16px;outline:none}.field input:focus,.field select:focus,.question select:focus{border-color:#22d3ee;box-shadow:0 0 0 4px rgba(34,211,238,.15)}
    .questions{display:grid;gap:14px}.question{display:grid;grid-template-columns:1fr 245px;gap:18px;align-items:center;padding:18px;border:1px solid #e2e8f0;border-radius:20px;background:#fff}.question p{margin:0;line-height:1.55;color:#334155}.q-title{font-weight:600;color:#0f172a}.q-context{font-size:13px;color:#64748b;margin-top:7px}.wizard-actions{padding:22px 30px;border-top:1px solid var(--line);display:flex;justify-content:space-between;gap:12px}
    .results{display:none}.results.active{display:block}.report{background:#fff;color:var(--ink);border:1px solid var(--line);border-radius:32px;padding:34px;box-shadow:0 20px 60px rgba(15,23,42,.08)}.report-head{display:flex;justify-content:space-between;align-items:center;gap:24px;border-bottom:2px solid #e2e8f0;padding-bottom:22px;margin-bottom:26px}.report-head img{width:150px;border-radius:18px}.kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}.kpi{border:1px solid var(--line);border-radius:26px;background:white;padding:22px}.kpi strong{font-size:40px;line-height:1;color:#0891b2;display:block}.kpi span{display:block;color:#64748b;margin-top:8px}
    .gauge{height:18px;background:#e2e8f0;border-radius:999px;overflow:hidden;margin:20px 0}.gauge-fill{height:100%;width:0;background:linear-gradient(90deg,var(--red),var(--orange),var(--yellow),var(--green));border-radius:999px}.two-col,.insight-grid{display:grid;grid-template-columns:1fr 1fr;gap:28px;margin-top:28px}.bars{display:grid;gap:14px}.bar-row{display:grid;grid-template-columns:120px 1fr 58px;gap:12px;align-items:center}.bar-bg{height:15px;background:#e2e8f0;border-radius:999px;overflow:hidden}.bar-fill{height:100%;background:linear-gradient(90deg,var(--blue),var(--cyan));border-radius:999px}.radar{width:100%;max-width:420px}.insight{border:1px solid var(--line);border-radius:26px;background:white;padding:24px}.insight h3{font-size:25px;margin-top:0}.insight ul{padding-left:18px;color:#475569;line-height:1.7}
    .risk{border-left:5px solid var(--orange);background:#fff7ed;border-radius:16px;padding:16px;margin-top:12px;color:#7c2d12}.risk.high{border-left-color:var(--red);background:#fef2f2;color:#7f1d1d}.quickwin{border-left:5px solid var(--green);background:#f0fdf4;border-radius:16px;padding:16px;margin-top:12px;color:#14532d}.roadmap,.process-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-top:22px}.road{background:#f8fafc;border:1px solid #e2e8f0;border-radius:22px;padding:20px}.road strong{display:block;color:#0369a1;font-size:20px;margin-bottom:10px}.process-grid{grid-template-columns:repeat(6,1fr)}.process{background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.12);border-radius:22px;padding:18px;text-align:center}.process b{color:var(--cyan)}.source-note{font-size:13px;color:#64748b;line-height:1.6;margin-top:22px}.badge{display:inline-flex;border-radius:999px;padding:7px 12px;font-weight:600;font-size:12px}.badge.red{background:#fee2e2;color:#991b1b}.badge.orange{background:#ffedd5;color:#9a3412}.badge.yellow{background:#fef9c3;color:#854d0e}.badge.green{background:#dcfce7;color:#166534}.services-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:22px}.service-rec{border:1px solid #e2e8f0;border-radius:18px;padding:18px;background:#f8fafc}.service-rec strong{display:block;color:#020817}

    .final-review{display:grid;grid-template-columns:1.1fr .9fr;gap:22px}
    .review-card{border:1px solid #e2e8f0;border-radius:24px;background:#fff;padding:24px}
    .review-card h3{margin:0 0 16px;font-size:24px;letter-spacing:-.03em}
    .review-table{display:grid;gap:0;border:1px solid #e2e8f0;border-radius:18px;overflow:hidden}
    .review-row{display:grid;grid-template-columns:220px 1fr;gap:18px;padding:14px 16px;border-bottom:1px solid #e2e8f0;align-items:center}
    .review-row:last-child{border-bottom:none}
    .review-row b{color:#334155}
    .review-benefit{display:flex;gap:14px;align-items:flex-start;padding:14px 0;border-bottom:1px solid #e2e8f0}
    .review-benefit:last-child{border-bottom:none}
    .review-icon{min-width:42px;height:42px;border-radius:14px;background:#e0f7ff;color:#0284c7;display:grid;place-items:center;font-weight:600;font-family:"IBM Plex Mono",ui-monospace,SFMono-Regular,Menlo,monospace}
    .domain-en{color:rgba(255,255,255,.5);font-size:13px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;margin-top:4px}
    .q-help{margin:0 0 16px;color:#475569;line-height:1.6}
    .question.missing{border-color:#f87171;background:#fef2f2}
    .wizard-error{margin:0 0 18px;border:1px solid #fecaca;background:#fef2f2;color:#991b1b;border-radius:16px;padding:14px 16px;font-weight:700}
    .consent{display:flex;gap:10px;align-items:flex-start;margin-top:16px;color:#334155;line-height:1.5;cursor:pointer}.consent input{margin-top:4px;width:18px;height:18px;flex:none}.consent a{color:#0369a1;text-decoration:underline}
    .workshop-note{margin:14px 0 0;color:#475569;font-size:14px;line-height:1.6}
    .muted{color:#64748b}.btn:disabled{opacity:.45;cursor:not-allowed;transform:none}
    .road ul{margin:0;padding-left:18px;color:#334155;line-height:1.55}.road li{margin-bottom:6px}
    .site-footer{border-top:1px solid rgba(255,255,255,.1);background:#020817;color:rgba(255,255,255,.6);padding:28px 0;font-size:14px}.site-footer .row{display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap}.site-footer a{text-decoration:underline}
    @media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*{transition:none!important;animation:none!important}}
    .privacy-note{margin-top:18px;border:1px solid #bbf7d0;background:#f0fdf4;color:#14532d;border-radius:18px;padding:16px;line-height:1.55}

    @media(max-width:980px){.hero-grid,.two-col,.insight-grid,.final-review{grid-template-columns:1fr}.value-grid,.domain-grid,.kpis,.services-grid{grid-template-columns:1fr 1fr}.question{grid-template-columns:1fr}.roadmap,.process-grid{grid-template-columns:1fr 1fr}}@media(max-width:620px){.review-row{grid-template-columns:1fr;gap:5px}.nav{align-items:flex-start;flex-direction:column;padding:16px 0}.brand-sub{display:none}.value-grid,.domain-grid,.kpis,.roadmap,.process-grid,.form-grid,.services-grid{grid-template-columns:1fr}.wizard-head{flex-direction:column}.hero{padding-top:48px}}
    @media print{.no-print,.header,.hero,.intro,.wizard-section,.actions-print,.site-footer{display:none!important}.results{display:block!important}.section{padding:0}.container{width:100%}.report{box-shadow:none;border:none;border-radius:0}.soft{background:#fff}body{background:#fff;color:#0f172a}.report-head{page-break-after:avoid}.page-break{page-break-before:always}}
  </style>
</head>
<body>
  <header class="header no-print">
    <div class="container nav">
      <a class="brand" href="/">
        <img src="/images/logo.webp" width="60" height="60" alt="ALLUNIFIED" />
        <div><div class="brand-title">ALLUNIFIED</div><div class="brand-sub">ACMA v1.1</div></div>
      </a>
      <a class="btn btn-primary" href="#start">Iniciar assessment</a>
    </div>
  </header>

  <main>
    <section class="hero no-print">
      <div class="container hero-grid">
        <div>
          <div class="eyebrow">ALLUNIFIED Cyber Maturity Assessment</div>
          <h1>Conozca su madurez. Priorice inversión. Fortalezca su negocio.</h1>
          <p class="hero-copy">ACMA v1.1 es una valoración primaria basada en NIST CSF 2.0 que permite identificar fortalezas, debilidades, riesgos prioritarios y un roadmap ejecutivo para elevar la postura de ciberseguridad.</p>
          <div class="hero-actions">
            <a class="btn btn-primary" href="#start">Iniciar assessment</a>
            <a class="btn" href="#descripcion">Qué recibirá</a>
          </div>
        </div>
        <aside class="hero-card">
          <h2>Assessment ejecutivo completo</h2>
          <p class="hero-copy" style="font-size:17px;margin-top:12px">Sus respuestas no salen de su navegador · 48 preguntas ponderadas · 6 dominios · dashboard ejecutivo · fortalezas · debilidades · riesgos · quick wins · roadmap · PDF.</p>
          <div class="quick-grid">
            <div class="quick"><strong>6</strong><span>funciones NIST CSF 2.0</span></div>
            <div class="quick"><strong>48</strong><span>controles ejecutivos</span></div>
            <div class="quick"><strong>PDF</strong><span>informe profesional</span></div>
            <div class="quick"><strong>Roadmap</strong><span>30/90/180/365 días</span></div>
          </div>
        </aside>
      </div>
    </section>

    <section id="descripcion" class="section white intro no-print">
      <div class="container">
        <div class="eyebrow">Por qué ACMA</div>
        <h2 class="section-title">¿Qué es ACMA y por qué conviene realizarlo?</h2>
        <p class="section-copy">La mayoría de las organizaciones conoce qué tecnología posee, pero no siempre entiende su nivel real de madurez, resiliencia y exposición. ACMA ayuda a convertir respuestas ejecutivas en un mapa inicial de riesgos, fortalezas y prioridades de mejora. Es el primer paso antes de un assessment técnico en campo.</p>
        <div class="value-grid">
          <div class="value-card"><strong>Diagnóstico inicial</strong><p>Obtenga una lectura ejecutiva de su postura de seguridad sin instalar software ni interrumpir la operación.</p></div>
          <div class="value-card"><strong>Fortalezas y debilidades</strong><p>Identifique qué capacidades ya aportan valor y qué brechas requieren atención prioritaria.</p></div>
          <div class="value-card"><strong>Dashboard accionable</strong><p>Visualice madurez global, dominios NIST, radar, barras, riesgos y recomendaciones.</p></div>
          <div class="value-card"><strong>Puente a consultoría</strong><p>Use el resultado para iniciar un workshop ejecutivo y validar hallazgos mediante assessment técnico.</p></div>
        </div>
      </div>
    </section>

    <section class="section dark intro no-print">
      <div class="container">
        <div class="eyebrow">Qué evaluaremos</div>
        <h2 class="section-title">Seis dominios inspirados en NIST CSF 2.0.</h2>
        <div class="domain-grid" id="domainCards"></div>
      </div>
    </section>

    <section id="start" class="section soft wizard-section no-print">
      <div class="container">
        <div class="panel">
          <div class="wizard-head">
            <div>
              <div class="eyebrow" id="stepEyebrow">Paso 1 de 8</div>
              <div class="wizard-title" id="stepTitle">Información de la empresa</div>
              <div class="wizard-sub" id="stepSub">Datos básicos para personalizar el dashboard y el PDF.</div>
            </div>
            <div style="font-weight:600;color:#0891b2;font-family:'IBM Plex Mono',monospace" id="stepPercent">0%</div>
          </div>
          <div class="panel-body">
            <div class="progress"><div class="progress-fill" id="progressFill"></div></div>
            <div class="wizard-error" id="wizardError" role="alert" hidden></div>
            <div id="wizardContent"></div>
          </div>
          <div class="wizard-actions">
            <button type="button" class="btn btn-soft" id="prevButton">Anterior</button>
            <button type="button" class="btn btn-primary" id="nextButton">Siguiente</button>
          </div>
        </div>
      </div>
    </section>

    <section id="resultsSection" class="section soft results">
      <div class="container">
        <div class="report">
          <div class="report-head">
            <div>
              <div class="eyebrow">ACMA v1.1 · Dashboard ejecutivo de madurez</div>
              <h2 class="section-title" style="font-size:44px">Reporte ejecutivo de madurez</h2>
              <p class="section-copy" id="reportMeta" style="font-size:16px;margin-top:12px"></p>
            </div>
            <img src="/images/logo.webp" width="150" height="150" alt="ALLUNIFIED"/>
          </div>

          <div class="kpis">
            <div class="kpi"><strong id="overallScore">0</strong><span>Madurez general</span></div>
            <div class="kpi"><strong id="levelName">Inicial</strong><span>Nivel</span></div>
            <div class="kpi"><strong id="riskLevel">Alto</strong><span>Riesgo general</span></div>
            <div class="kpi"><strong id="resilienceIndex">0</strong><span>Índice de resiliencia</span></div>
          </div>
          <div class="gauge"><div class="gauge-fill" id="gaugeFill"></div></div>

          <div class="two-col">
            <div><h3>Madurez por dominio</h3><div class="bars" id="bars"></div></div>
            <div><h3>Radar ejecutivo</h3><svg class="radar" viewBox="0 0 440 370" id="radarSvg"></svg></div>
          </div>

          <div class="insight-grid page-break">
            <div class="insight"><h3>Fortalezas identificadas</h3><ul id="strengths"></ul></div>
            <div class="insight"><h3>Debilidades prioritarias</h3><ul id="weaknesses"></ul></div>
          </div>

          <div class="two-col">
            <div><h3>Riesgos prioritarios</h3><div id="risks"></div></div>
            <div><h3>Quick Wins</h3><div id="quickwins"></div></div>
          </div>

          <div class="insight" style="margin-top:28px"><h3>Interpretación ejecutiva</h3><p id="executiveSummary" class="section-copy" style="font-size:16px;margin-top:0"></p></div>

          <h3 style="margin-top:34px">Roadmap recomendado</h3>
          <div class="roadmap" id="roadmap"></div>

          <h3 style="margin-top:34px">Servicios sugeridos de ALLUNIFIED</h3>
          <div class="services-grid" id="servicesRec"></div>

          <h3 style="margin-top:34px">Modelo de acompañamiento</h3>
          <div class="process-grid">
            <div class="process"><b>1</b><br/>Assessment Digital</div>
            <div class="process"><b>2</b><br/>Workshop Ejecutivo</div>
            <div class="process"><b>3</b><br/>Assessment Técnico</div>
            <div class="process"><b>4</b><br/>Roadmap Estratégico</div>
            <div class="process"><b>5</b><br/>Implementación</div>
            <div class="process"><b>6</b><br/>Servicios Administrados</div>
          </div>

          <p class="source-note">ACMA v1.1 es una valoración primaria desarrollada por ALLUNIFIED e inspirada en NIST CSF 2.0. No constituye certificación, auditoría formal ni evaluación oficial de NIST. Los resultados deben validarse mediante workshop ejecutivo y assessment técnico en campo.</p>
        </div>

        <div class="hero-actions actions-print" style="margin-top:24px">
          <button type="button" class="btn btn-primary" id="printButton">Generar PDF / Guardar como PDF</button>
          <a class="btn btn-dark" id="workshopWhatsapp" href="https://wa.me/525599152707" target="_blank" rel="noopener">Solicitar Workshop por WhatsApp</a>
          <a class="btn btn-soft" id="workshopEmail" href="mailto:contacto@allunifiedst.com">Solicitar por correo</a>
        </div>
        <p class="workshop-note no-print">¿Prefiere escribir desde su correo? <strong>contacto@allunifiedst.com</strong> · WhatsApp <strong>+52 55 9915 2707</strong>. Solo se comparte lo que usted envíe.</p>
      </div>
    </section>
  </main>
  <footer class="site-footer no-print">
    <div class="container row">
      <span>© 2026 ALLUNIFIED Servicios Tecnológicos, S. de R.L. de C.V.</span>
      <span><a href="/">Inicio</a> · <a href="/privacidad">Aviso de privacidad</a> · <a href="mailto:contacto@allunifiedst.com">contacto@allunifiedst.com</a></span>
